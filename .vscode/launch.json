{
    "version": "0.2.0",
    "configurations": [
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug inverter example",
            "cargo": {
                "args": [
                    "run",
                    "--example=sipo_block",
                    "--package=copper"
                ],
                "filter": {
                    "name": "sipo_block",
                    "kind": "bin"
                }
            },
            "args": [],
            "cwd": "${workspaceFolder}"
        },
        {
            "type": "lldb",
            "request": "launch",
            "name": "Debug tests",
            "cargo": {
                "args": [
                    "test",
                    "--package=copper",
                    "--lib",
                    "--",
                    "--nocapture"
                ],
                "filter": {
                    "name": "sipo_block",
                    "kind": "bin"
                }
            },
            "args": [],
            "cwd": "${workspaceFolder}"
        }
    ]
}
